diff --git a/src/util/alg_ds/ds/lock_guard/lock_guard.h b/src/util/alg_ds/ds/lock_guard/lock_guard.h
--- a/src/util/alg_ds/ds/lock_guard/lock_guard.h
+++ b/src/util/alg_ds/ds/lock_guard/lock_guard.h
@@ -43,22 +43,40 @@
 
 #define CHECK_TYPE_INLINE(val, type) (void)_Generic((val), type: mir_dummy_lock_guard, const type: mir_dummy_lock_guard_const)
 
+typedef struct {
+  pthread_mutex_t* mutex;
+} mir_lock_guard_state_t;
+
+static inline
+mir_lock_guard_state_t mir_lock_guard_acquire(pthread_mutex_t* mutex)
+{
+  assert(mutex != NULL);
+  const int rc = pthread_mutex_lock(mutex);
+  if(rc != 0){
+    fprintf(stdout, "Error while locking: %s\n", strerror(rc));
+    fflush(stdout);
+    assert(rc == 0);
+  }
+  return (mir_lock_guard_state_t){.mutex = mutex};
+}
+
+static inline
+void mir_lock_guard_release(mir_lock_guard_state_t* state)
+{
+  if(state == NULL || state->mutex == NULL)
+    return;
+  const int rc = pthread_mutex_unlock(state->mutex);
+  if(rc != 0){
+    fprintf(stdout, "Error while unlocking: %s\n", strerror(rc));
+    fflush(stdout);
+    assert(rc == 0);
+  }
+}
+
 #define lock_guard(X) \
+  __attribute__((__cleanup__(mir_lock_guard_release), unused)) \
+  mir_lock_guard_state_t MACRO_CONCAT(mir_lock_guard_, __COUNTER__) = \
+    mir_lock_guard_acquire((X))
